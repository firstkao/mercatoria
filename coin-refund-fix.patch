From 7e4d7c2c47fc6c45c64e468a2310b8e9deafcec9 Mon Sep 17 00:00:00 2001
From: "qwen.ai[bot]" <qwenlm-intl@service.alibaba.com>
Date: Thu, 1 Oct 2026 13:21:13 +0000
Subject: [PATCH] Fix: refund koin ke lot kedaluwarsa kini dipindah ke lot baru
 (refund_kedaluwarsa) agar tidak hilang permanen

---
 .../Console/Commands/CancelUnpaidOrders.php   | 26 ++++++++++++++++---
 .../Admin/OrderManagementController.php       | 25 +++++++++++++++---
 2 files changed, 44 insertions(+), 7 deletions(-)

diff --git a/plain/app/Console/Commands/CancelUnpaidOrders.php b/plain/app/Console/Commands/CancelUnpaidOrders.php
index 970542c..5a75a79 100644
--- a/plain/app/Console/Commands/CancelUnpaidOrders.php
+++ b/plain/app/Console/Commands/CancelUnpaidOrders.php
@@ -50,13 +50,31 @@ class CancelUnpaidOrders extends Command
                     'cancelled_at' => now(),
                 ]);
 
-                // Kembalikan koin yang terpakai
+                // Kembalikan koin yang terpakai. Kalau lot asalnya sudah kedaluwarsa,
+                // jangan di-crement ke lot mati (tidak akan muncul sebagai saldo aktif):
+                // pindahkan sisa amount ke lot baru berumur penuh sesuai setting.
                 $spentCoins = DB::table('coin_spends')->where('order_id', $order->id)->get();
                 if ($spentCoins->isNotEmpty()) {
+                    $expiryMonths = \App\Models\Setting::integer('coin_expiry_months', 12);
                     foreach ($spentCoins as $spend) {
-                        DB::table('coin_lots')
-                            ->where('id', $spend->coin_lot_id)
-                            ->increment('remaining', $spend->amount);
+                        $lot = DB::table('coin_lots')->where('id', $spend->coin_lot_id)->first();
+                        $lotExpired = $lot && $lot->expires_at !== null && strtotime($lot->expires_at) <= time();
+
+                        if ($lotExpired) {
+                            \App\Models\CoinLot::create([
+                                'user_id' => $order->user_id,
+                                'source' => 'refund_kedaluwarsa',
+                                'order_id' => $order->id,
+                                'amount' => $spend->amount,
+                                'remaining' => $spend->amount,
+                                'earned_at' => now(),
+                                'expires_at' => now()->addMonths($expiryMonths),
+                            ]);
+                        } else {
+                            DB::table('coin_lots')
+                                ->where('id', $spend->coin_lot_id)
+                                ->increment('remaining', $spend->amount);
+                        }
                     }
                     DB::table('coin_spends')->where('order_id', $order->id)->delete();
                     $refunded[] = 'koin';
diff --git a/plain/app/Http/Controllers/Admin/OrderManagementController.php b/plain/app/Http/Controllers/Admin/OrderManagementController.php
index e437066..c8a0e36 100644
--- a/plain/app/Http/Controllers/Admin/OrderManagementController.php
+++ b/plain/app/Http/Controllers/Admin/OrderManagementController.php
@@ -202,10 +202,29 @@ class OrderManagementController extends Controller
     {
         $spends = DB::table('coin_spends')->where('order_id', $order->id)->get();
 
+        $expiryMonths = Setting::integer('coin_expiry_months', 12);
+
         foreach ($spends as $spend) {
-            DB::table('coin_lots')
-                ->where('id', $spend->coin_lot_id)
-                ->increment('remaining', $spend->amount);
+            $lot = DB::table('coin_lots')->where('id', $spend->coin_lot_id)->first();
+            $lotExpired = $lot && $lot->expires_at !== null && strtotime($lot->expires_at) <= time();
+
+            if ($lotExpired) {
+                // Lot asal sudah kedaluwarsa — increment ke sana tidak akan pernah
+                // terlihat sebagai saldo aktif. Buat lot refund baru berumur penuh.
+                CoinLot::create([
+                    'user_id' => $order->user_id,
+                    'source' => 'refund_kedaluwarsa',
+                    'order_id' => $order->id,
+                    'amount' => $spend->amount,
+                    'remaining' => $spend->amount,
+                    'earned_at' => now(),
+                    'expires_at' => now()->addMonths($expiryMonths),
+                ]);
+            } else {
+                DB::table('coin_lots')
+                    ->where('id', $spend->coin_lot_id)
+                    ->increment('remaining', $spend->amount);
+            }
         }
 
         if ($spends->isNotEmpty()) {
-- 
2.39.5

