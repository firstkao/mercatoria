{(function () {
    // ── Baca config dari JSON block di Blade ──
    var configEl = document.getElementById('product-form-config');
    if (!configEl) return;
    var CONFIG = JSON.parse(configEl.textContent);

    var CFG = CONFIG.cfg;
    var PRODUCT_EXISTS = CONFIG.productExists;
    var VARIANT_BASE_URL = CONFIG.variantBaseUrl;
    var CSRF_TOKEN = CONFIG.csrfToken;

    function rp(n) { return 'Rp ' + Math.round(n).toLocaleString('id-ID'); }

    // ── Tabs ──
    var tabs = document.querySelectorAll('.prod-tab');
    var panels = document.querySelectorAll('.prod-panel');
    tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
            tabs.forEach(function (t) {
                t.classList.remove('border-ink', 'font-semibold', 'text-ink');
                t.classList.add('border-transparent', 'text-ink/55');
            });
            tab.classList.remove('border-transparent', 'text-ink/55');
            tab.classList.add('border-ink', 'font-semibold', 'text-ink');
            var key = tab.getAttribute('data-prod-tab');
            panels.forEach(function (p) {
                p.classList.toggle('hidden', p.getAttribute('data-prod-panel') !== key);
            });
        });
    });

    // ── Live Preview ──
    var priceInput = document.getElementById('input-price-rmb');
    var weightInput = document.getElementById('input-weight-gram');
    var sidebarStore = document.getElementById('sidebar-store-id');
    var tabStore = document.getElementById('input-store-id');
    var discountInput = document.querySelector('[name="discount_amount_rmb"]');

    function recalc() {
        var priceRmb = parseFloat(priceInput && priceInput.value) || 0;
        var weightG = parseFloat(weightInput && weightInput.value) || CFG.default_weight;
        var weightKg = weightG / 1000;
        var rate = CFG.rate_rmb;
        var diskonRmb = parseFloat(discountInput && discountInput.value) || 0;

        var activeStore = (sidebarStore && sidebarStore.value) ? sidebarStore : tabStore;
        var storeOpt = activeStore && activeStore.selectedOptions && activeStore.selectedOptions[0];
        var storeName = (storeOpt && storeOpt.text.trim()) || 'Default (Game)';
        var ongkirPct = parseFloat(storeOpt && storeOpt.dataset.ongkir) || 7;
        var minRmb = parseFloat(storeOpt && storeOpt.dataset.min) || 0;

        var hargaProduk = priceRmb * rate;
        var ongkirLokalRmb = (priceRmb * ongkirPct) / 100;
        var ongkirLokal = ongkirLokalRmb * rate;
        var ongkirCnBtm = weightKg * CFG.ongkir_cn_btm;
        var ongkirBtmJkt = weightKg * CFG.ongkir_btm_jkt;
        var diskonIdr = diskonRmb * rate;
        var subtotal = hargaProduk + ongkirLokal + ongkirCnBtm + ongkirBtmJkt - diskonIdr;
        var profit = subtotal * CFG.profit_percent / 100;
        var total = subtotal + profit;
        var rounded = Math.ceil(total / 1000) * 1000;

        function set(id, val) { var el = document.getElementById(id); if (el) el.textContent = val; }

        set('pv-rmb', priceRmb + ' RMB');
        set('pv-berat', weightG + ' gram');
        set('pv-store', storeName);
        set('pv-rate', rp(rate));

        set('disp-ongkir-lokal', ongkirLokalRmb.toFixed(2) + ' RMB');
        set('info-ongkir-lokal', 'Store: ' + storeName + ' (Min ' + minRmb + ' RMB, Ongkir ' + ongkirPct + '%)');
        set('disp-ongkir-cnbtm', rp(ongkirCnBtm));
        set('info-ongkir-cnbtm', 'Berat ' + weightKg.toFixed(1) + ' kg \u00d7 ' + CFG.ongkir_cn_btm.toLocaleString('id-ID') + '/kg = ' + rp(ongkirCnBtm));
        set('disp-ongkir-btmjkt', rp(ongkirBtmJkt));
        set('info-ongkir-btmjkt', 'Berat ' + weightKg.toFixed(1) + ' kg \u00d7 ' + CFG.ongkir_btm_jkt.toLocaleString('id-ID') + '/kg = ' + rp(ongkirBtmJkt));

        set('calc-harga-formula', priceRmb + ' \u00d7 ' + rate.toLocaleString('id-ID'));
        set('calc-harga', rp(hargaProduk));
        set('calc-lokal-formula', '(' + priceRmb + ' \u00d7 ' + ongkirPct + ') / 100');
        set('calc-lokal', rp(ongkirLokal));
        set('calc-cnbtm-formula', weightKg.toFixed(1) + ' kg \u00d7 ' + CFG.ongkir_cn_btm.toLocaleString('id-ID'));
        set('calc-cnbtm', rp(ongkirCnBtm));
        set('calc-btmjkt-formula', weightKg.toFixed(1) + ' kg \u00d7 ' + CFG.ongkir_btm_jkt.toLocaleString('id-ID'));
        set('calc-btmjkt', rp(ongkirBtmJkt));

        // Diskon row
        var diskonRow = document.getElementById('calc-diskon-row');
        if (diskonRow) {
            if (diskonRmb > 0) {
                diskonRow.classList.remove('hidden');
                set('calc-diskon-formula', diskonRmb + ' \u00d7 ' + rate.toLocaleString('id-ID'));
                set('calc-diskon', '-' + rp(diskonIdr));
            } else {
                diskonRow.classList.add('hidden');
            }
        }

        set('calc-subtotal', rp(subtotal));
        set('calc-profit-label', 'Profit ' + CFG.profit_percent + '%:');
        set('calc-profit', rp(profit));
        set('calc-total', rp(total));
        set('calc-rounded', rp(rounded));
        set('calc-customer', rounded.toLocaleString('id-ID'));
    }

    if (priceInput) priceInput.addEventListener('input', recalc);
    if (weightInput) weightInput.addEventListener('input', recalc);
    if (discountInput) discountInput.addEventListener('input', recalc);
    if (sidebarStore) sidebarStore.addEventListener('change', function () {
        if (tabStore) tabStore.value = sidebarStore.value;
        recalc();
    });
    if (tabStore) tabStore.addEventListener('change', function () {
        if (sidebarStore) sidebarStore.value = tabStore.value;
        document.querySelectorAll('input[name="game_id_sidebar"]').forEach(function (r) {
            r.checked = (r.value === tabStore.value);
        });
        recalc();
    });
    recalc();

    // ── Variant checkbox ──
    document.addEventListener('change', function (e) {
        if (e.target.classList.contains('variant-check') || e.target.id === 'check-all-variants') {
            if (e.target.id === 'check-all-variants') {
                document.querySelectorAll('.variant-check').forEach(function (c) { c.checked = e.target.checked; });
            }
            var n = document.querySelectorAll('.variant-check:checked').length;
            var el = document.getElementById('variant-selected-count');
            if (el) el.textContent = n + ' varian terpilih';
        }
    });

    // ═══ FILE SIZE VALIDATION ═══
    function validateFileSize(input, maxMB) {
        if (input.files && input.files[0]) {
            var sizeMB = input.files[0].size / 1024 / 1024;
            if (sizeMB > maxMB) {
                alert('Ukuran file ' + sizeMB.toFixed(1) + ' MB melebihi batas ' + maxMB + ' MB.');
                input.value = '';
                return false;
            }
        }
        return true;
    }

    // ═══ DESC IMAGE ═══
    window.previewDescImage = function (input) {
        if (!validateFileSize(input, 6)) return;
        if (!input.files || !input.files[0]) return;

        var flag = document.getElementById('remove-desc-flag');
        if (flag) flag.value = '0';

        var file = input.files[0];
        var reader = new FileReader();
        reader.onload = function (e) {
            var uploadArea = document.getElementById('desc-upload-area');
            var previewArea = document.getElementById('desc-preview-area');
            if (uploadArea) uploadArea.classList.add('hidden');
            if (previewArea) previewArea.classList.remove('hidden');

            var img = document.getElementById('desc-preview-img');
            if (img) img.src = e.target.result;

            var nameEl = document.getElementById('desc-preview-name');
            if (nameEl) nameEl.textContent = file.name;

            var sizeEl = document.getElementById('desc-preview-size');
            if (sizeEl) sizeEl.textContent = (file.size / 1024 / 1024).toFixed(2) + ' MB \u2014 baru dipilih';
        };
        reader.readAsDataURL(file);
    };

    window.removeDescImage = function () {
        var input = document.getElementById('desc-image-input');
        if (input) input.value = '';

        var flag = document.getElementById('remove-desc-flag');
        if (flag) flag.value = '1';

        var uploadArea = document.getElementById('desc-upload-area');
        var previewArea = document.getElementById('desc-preview-area');
        if (uploadArea) uploadArea.classList.remove('hidden');
        if (previewArea) previewArea.classList.add('hidden');

        var img = document.getElementById('desc-preview-img');
        if (img) img.src = '';
        var nameEl = document.getElementById('desc-preview-name');
        if (nameEl) nameEl.textContent = '\u2014';
        var sizeEl = document.getElementById('desc-preview-size');
        if (sizeEl) sizeEl.textContent = '\u2014';
    };

    // ═══ PHOTO (sidebar) ═══
    window.previewPhoto = function (input) {
        if (!validateFileSize(input, 6)) return;
        if (!input.files || !input.files[0]) return;
        var reader = new FileReader();
        reader.onload = function (e) {
            var preview = document.getElementById('photo-preview');
            if (preview) {
                preview.innerHTML = '<img src="' + e.target.result + '" class="h-full w-full object-cover" alt="Foto">';
            }
        };
        reader.readAsDataURL(input.files[0]);
    };

    // ═══ MODALS ═══
    function openModal(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('hidden'); el.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }
    function closeModal(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.add('hidden'); el.classList.remove('flex');
        document.body.style.overflow = '';
    }

    window.openDeleteModal = function () { openModal('modal-delete'); };
    window.closeDeleteModal = function () { closeModal('modal-delete'); };

    // ═══ EDIT VARIANT ═══
    var currentVariantId = null;

    window.editVariant = function (id) {
        if (!PRODUCT_EXISTS) return;
        currentVariantId = id;
        var checkbox = document.querySelector('.variant-check[value="' + id + '"]');
        if (!checkbox) return;

        document.getElementById('ev-name').value = checkbox.dataset.name || '';
        document.getElementById('ev-sku').value = checkbox.dataset.sku || '';
        document.getElementById('ev-price').value = checkbox.dataset.price || '';
        document.getElementById('ev-weight').value = checkbox.dataset.weight || '';
        document.getElementById('ev-availability').value = checkbox.dataset.availability || 'tersedia';

        var imgPreview = document.getElementById('ev-image-preview');
        var imgThumb = document.getElementById('ev-image-thumb');
        if (checkbox.dataset.image) {
            imgThumb.src = checkbox.dataset.image;
            imgPreview.classList.remove('hidden');
        } else {
            imgPreview.classList.add('hidden');
        }

        document.getElementById('form-edit-variant').action = VARIANT_BASE_URL + '/' + id;
        openModal('modal-edit-variant');
    };

    window.closeEditVariant = function () {
        closeModal('modal-edit-variant');
        currentVariantId = null;
    };

    window.deleteVariant = function () {
        if (!currentVariantId) return;
        if (!confirm('Hapus varian ini permanen? Tindakan tidak bisa dibatalkan.')) return;

        var form = document.createElement('form');
        form.method = 'POST';
        form.action = VARIANT_BASE_URL + '/' + currentVariantId;

        var csrf = document.createElement('input');
        csrf.type = 'hidden'; csrf.name = '_token'; csrf.value = CSRF_TOKEN;
        form.appendChild(csrf);

        var method = document.createElement('input');
        method.type = 'hidden'; method.name = '_method'; method.value = 'DELETE';
        form.appendChild(method);

        document.body.appendChild(form);
        form.submit();
    };

    // ═══ BULK WEIGHT ═══
    window.openBulkWeight = function () {
        var checked = Array.from(document.querySelectorAll('.variant-check:checked'));
        if (!checked.length) return;
        document.getElementById('bulk-count').textContent = checked.length;
        document.getElementById('bulk-apply-count').textContent = checked.length;
        var html = '';
        checked.forEach(function (c) {
            var w = c.dataset.weight || '\u2014';
            html += '<li>\u2022 ' + (c.dataset.sku || '#' + c.value) + ' ' + (c.dataset.name || '') + ': ' + (w !== '\u2014' ? w + 'g' : '\u2014') + '</li>';
        });
        document.getElementById('bulk-list').innerHTML = html;
        openModal('modal-bulk-weight');
    };
    window.closeBulkWeight = function () { closeModal('modal-bulk-weight'); };

    window.updateBulkPreview = function () {
        var val = document.getElementById('bulk-weight-input').value;
        var checked = Array.from(document.querySelectorAll('.variant-check:checked'));
        if (!val) { document.getElementById('bulk-preview-text').textContent = 'Masukkan berat untuk preview...'; return; }
        var text = checked.length + ' varian akan diubah ke: ' + val + ' gram<br><br>';
        checked.forEach(function (c) {
            var w = c.dataset.weight || '\u2014';
            text += '\u2022 ' + (c.dataset.sku || '#' + c.value) + ' ' + (c.dataset.name || '') + ': ' + (w !== '\u2014' ? w + 'g' : '\u2014') + ' \u2192 ' + val + 'g' + (w == val ? ' (sama)' : '') + '<br>';
        });
        document.getElementById('bulk-preview-text').innerHTML = text;
    };

    window.applyBulkWeight = function () {
        var val = parseInt(document.getElementById('bulk-weight-input').value);
        if (!val) return;
        var checked = Array.from(document.querySelectorAll('.variant-check:checked'));
        var ids = checked.map(function (c) { return parseInt(c.value); });

        var btn = document.getElementById('btn-apply-bulk');
        if (btn) { btn.disabled = true; btn.textContent = 'Menyimpan...'; }

        fetch(VARIANT_BASE_URL + '/bulk-weight', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': CSRF_TOKEN,
                'Accept': 'application/json'
            },
            body: JSON.stringify({ weight_gram: val, ids: ids })
        })
        .then(function (r) {
            if (!r.ok) throw new Error('Server error');
            return r.json();
        })
        .then(function () {
            checked.forEach(function (c) {
                c.dataset.weight = val;
                var row = c.closest('tr');
                if (row) { var cells = row.querySelectorAll('td'); if (cells[4]) cells[4].textContent = val + 'g'; }
            });
            closeModal('modal-bulk-weight');
            document.getElementById('bulk-success-msg').textContent = checked.length + ' varian berhasil diubah ke berat ' + val + ' gram. Sudah tersimpan.';
            openModal('modal-bulk-success');
            setTimeout(function () { closeModal('modal-bulk-success'); }, 2500);
        })
        .catch(function (err) {
            alert('Gagal menyimpan: ' + err.message + '. Pastikan varian sudah ada di database.');
        })
        .finally(function () {
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1.5" style="font-size:0.85rem;"></i> Apply ke <span id="bulk-apply-count">' + checked.length + '</span> Varian'; }
        });
    };
    window.closeBulkSuccess = function () { closeModal('modal-bulk-success'); };

    // ── Escape + backdrop ──
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeModal('modal-delete');
            closeModal('modal-bulk-weight');
            closeModal('modal-bulk-success');
            closeModal('modal-edit-variant');
        }
    });
    ['modal-delete','modal-bulk-weight','modal-bulk-success','modal-edit-variant'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('click', function (e) { if (e.target === el) closeModal(id); });
    });

})();